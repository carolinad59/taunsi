          "note": "Se escribe también «hout» y se oye así en la carta de los restaurantes.",
          "review": false
        },
        {
          "id": "u00-l02-7lib",
          "type": "word",
          "es": "leche",
          "tn": "7lib",
          "ar": "حليب",
