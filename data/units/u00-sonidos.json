    {
      "id": "u00-l01",
      "title": "Vocales y consonantes básicas",
      "kind": "normal",
      "grammar": {
        "title": "Vocales cortas y largas",
        "text_es": "Escribimos el tunecino con letras latinas (Arabizi). Las vocales a, e, i, o, u son breves; si se doblan (aa, ii) o se escribe «ou», suenan más largas. «ou» siempre suena como la «u» española. Las consonantes b, d, f, l, m, n, r, t y z suenan casi igual que en español."
      },
      "items": [
        {
          "id": "u00-l01-baba",
          "type": "word",
          "es": "papá",
          "tn": "baba",
          "ar": "بابا",
          "pron": "ba-ba, como en español",
          "note": "Se usa en toda Túnez.",
          "review": false
        },
        {
          "id": "u00-l01-yemma",
          "type": "word",
          "es": "mamá",
          "tn": "yemma",
          "ar": "يمّا",
          "pron": "ie-ma, con la «m» algo alargada",
          "alt": [
            "mama"
          ],
          "note": "«Yemma» es la forma más tunecina; también se oye «mama».",
          "review": false
        },
        {
          "id": "u00-l01-bab",
          "type": "word",
          "es": "puerta",
          "tn": "bab",
          "ar": "باب",
          "pron": "bab, con la «a» larga",
          "review": false
        },
        {
