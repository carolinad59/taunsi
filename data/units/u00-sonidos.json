    {
      "id": "u00-l02",
      "title": "Los sonidos de la garganta",
      "kind": "normal",
      "grammar": {
        "title": "Cinco sonidos nuevos",
        "text_es": "El 3 (ع, ayn) se hace apretando la garganta al decir una «a». El 7 (ح) es una «h» fuerte y aspirada. «kh» (también se escribe 5, خ) es una «j» española más raspada. El 6 (ط) es una «t» con la lengua más atrás. «gh» (también 8, غ) suena como la «r» francesa de «Paris»."
      },
      "items": [
        {
          "id": "u00-l02-3am",
          "type": "word",
          "es": "año",
          "tn": "3am",
          "ar": "عام",
          "pron": "«3» es la ayn: aprieta la garganta y di «a» desde dentro",
          "alt": [
            "3aam"
          ],
          "note": "Con la misma 3 empieza «3awed» (repite).",
          "review": false
        },
        {
          "id": "u00-l02-3in",
          "type": "word",
          "es": "ojo",
          "tn": "3in",
          "ar": "عين",
          "pron": "«3» de garganta + «in»",
          "review": false
        },
        {
          "id": "u00-l02-7out",
          "type": "word",
          "es": "pescado",
          "tn": "7out",
          "ar": "حوت",
          "pron": "«7» como si empañaras un cristal con el aliento",
          "alt": [
            "hout"
