    {
      "id": "u03-l03",
      "title": "Tener y no tener",
      "kind": "normal",
      "grammar": {
        "title": "3andi, famma",
        "text_es": "«3andi» (tengo), «3andek» (tienes), «3andou» (tiene él), «3andha» (tiene ella), «3andna» (tenemos). Negación: «ma 3andich». «Famma» = hay; «ma famech» = no hay. (En Egipto se dice «mafish»; en Túnez, «ma famech».)"
      },
